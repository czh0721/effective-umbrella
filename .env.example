# 复制为 .env 并填入你自己的值，.env 已被 .gitignore 忽略
# 这些变量名面向本项目，请勿复用 Agent 运行环境的变量名

# 单机 CLI（chat / distill）使用的默认模型配置
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_MODEL=deepseek-chat

# 可选：对话采样温度与最大输出长度
USER_LLM_TEMPERATURE=0.9
USER_LLM_MAX_TOKENS=1024

# ---- 多用户平台 ----
# 平台主密钥：用于加密各用户的大模型 Key；不设置时会在数据目录生成 .secret_key
PERSONA_SECRET_KEY=change-me-to-a-long-random-string

# 数据目录与数据库（默认 data/ 与 data/platform.db）
PERSONA_DATA_DIR=data
# PERSONA_DB_PATH=data/platform.db

# weclaw 可执行文件路径
WECLAW_BIN=weclaw

# 通过 HTTPS 对外时设为 1，会话 Cookie 会带上 Secure
PERSONA_SECURE_COOKIE=0

# ---- 平台内置模型（可选）----
# 用户未配置自己的 Key 时，回退到该模型；不设置即视为未启用
# PERSONA_PLATFORM_API_KEY=
# PERSONA_PLATFORM_BASE_URL=https://api.deepseek.com/v1
# PERSONA_PLATFORM_MODEL=deepseek-chat
# 每个用户每天可用平台模型的次数上限，0 表示不限制
# PERSONA_PLATFORM_DAILY_LIMIT=50

# 敏感词词库路径（默认 ex_persona/data/sensitive_words.txt）
# PERSONA_SENSITIVE_WORDS=/opt/nian/ex_persona/data/sensitive_words.txt

# 同一来源 IP 在 5 分钟内最多成功注册的账号数，0 表示不限制
# PERSONA_REGISTER_MAX=5

# 管理员白名单：逗号分隔用户名，启动与注册时自动提升为 admin
# PERSONA_ADMIN_USERS=alice,bob

# 可选：微信扫码登录（预留）。填好开放平台网站应用的凭据后登录页会出现扫码入口
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=https://your-domain/api/auth/wechat/callback
