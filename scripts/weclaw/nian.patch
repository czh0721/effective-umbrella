+func downloadImage(ctx context.Context, img *ilink.ImageItem) ([]byte, error) {
+	if img.URL != "" {
+		data, _, err := downloadFile(ctx, img.URL)
+		return data, err
+	}
+	if img.Media != nil && img.Media.EncryptQueryParam != "" {
+		return DownloadFileFromCDN(ctx, img.Media.EncryptQueryParam, img.Media.AESKey)
+	}
+	return nil, fmt.Errorf("image has no URL or media info")
+}
+
+// forwardImage downloads an incoming image/sticker and POSTs it to the configured
+// platform media endpoint so the bound persona can save it. Returns true when the
+// endpoint accepted the upload.
+func (h *Handler) forwardImage(ctx context.Context, msg ilink.WeixinMessage, img *ilink.ImageItem) bool {
+	data, err := downloadImage(ctx, img)
+	if err != nil {
+		log.Printf("[handler] failed to download image from %s: %v", msg.FromUserID, err)
+		return false
+	}
+	ext := detectImageExt(data)
+	fileName := "wechat-" + time.Now().Format("20060102-150405") + ext
+
+	var body bytes.Buffer
+	writer := multipart.NewWriter(&body)
+	part, err := writer.CreateFormFile("file", fileName)
+	if err != nil {
+		log.Printf("[handler] build media form failed: %v", err)
+		return false
+	}
+	if _, err := part.Write(data); err != nil {
+		log.Printf("[handler] write media form failed: %v", err)
+		return false
+	}
+	if err := writer.Close(); err != nil {
+		log.Printf("[handler] close media form failed: %v", err)
+		return false
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, h.mediaEndpoint, &body)
+	if err != nil {
+		log.Printf("[handler] build media request failed: %v", err)
+		return false
+	}
+	req.Header.Set("Content-Type", writer.FormDataContentType())
+	req.Header.Set("X-WeChat-From", msg.FromUserID)
+	if msg.MessageID != 0 {
+		req.Header.Set("X-WeChat-Message-ID", fmt.Sprintf("%d", msg.MessageID))
+	}
+
+	client := &http.Client{Timeout: 60 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		log.Printf("[handler] forward media to platform failed: %v", err)
+		return false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		log.Printf("[handler] platform rejected media: HTTP %d", resp.StatusCode)
+		return false
+	}
+	log.Printf("[handler] forwarded image from %s to platform (%d bytes)", msg.FromUserID, len(data))
+	return true
+}
+
+func extractVoice(msg ilink.WeixinMessage) *ilink.VoiceItem {
+	for _, item := range msg.ItemList {
+		if item.Type == ilink.ItemTypeVoice && item.VoiceItem != nil {
+			return item.VoiceItem
+		}
+	}
+	return nil
+}
+
+func downloadVoice(ctx context.Context, v *ilink.VoiceItem) ([]byte, error) {
+	if v.Media != nil && v.Media.EncryptQueryParam != "" {
+		return DownloadFileFromCDN(ctx, v.Media.EncryptQueryParam, v.Media.AESKey)
+	}
+	return nil, fmt.Errorf("voice has no media info")
+}
+
+// forwardVoice downloads an incoming voice message and POSTs the raw audio to the
+// configured platform voice endpoint so the bound persona can archive it. Returns
+// true when the endpoint accepted the upload. Failure never blocks the text flow.
+func (h *Handler) forwardVoice(ctx context.Context, msg ilink.WeixinMessage, v *ilink.VoiceItem) bool {
+	data, err := downloadVoice(ctx, v)
+	if err != nil {
+		log.Printf("[handler] failed to download voice from %s: %v", msg.FromUserID, err)
+		return false
+	}
+	fileName := "wechat-voice-" + time.Now().Format("20060102-150405") + ".bin"
+
+	var body bytes.Buffer
+	writer := multipart.NewWriter(&body)
+	part, err := writer.CreateFormFile("file", fileName)
+	if err != nil {
+		log.Printf("[handler] build voice form failed: %v", err)
+		return false
+	}
+	if _, err := part.Write(data); err != nil {
+		log.Printf("[handler] write voice form failed: %v", err)
+		return false
+	}
+	if err := writer.Close(); err != nil {
+		log.Printf("[handler] close voice form failed: %v", err)
+		return false
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, h.voiceEndpoint, &body)
+	if err != nil {
+		log.Printf("[handler] build voice request failed: %v", err)
+		return false
+	}
+	req.Header.Set("Content-Type", writer.FormDataContentType())
+	req.Header.Set("X-WeChat-From", msg.FromUserID)
+	if msg.MessageID != 0 {
+		req.Header.Set("X-WeChat-Message-ID", fmt.Sprintf("%d", msg.MessageID))
+	}
+	req.Header.Set("X-Voice-Duration-Ms", fmt.Sprintf("%d", v.Playtime))
+	if v.EncodeType != 0 {
+		req.Header.Set("X-Voice-Encode-Type", fmt.Sprintf("%d", v.EncodeType))
+	}
+	if v.Text != "" {
+		encoded := url.QueryEscape(v.Text)
+		if len(encoded) > 900 {
+			encoded = encoded[:900]
+		}
+		req.Header.Set("X-Voice-Transcript", encoded)
+	}
+
+	client := &http.Client{Timeout: 60 * time.Second}
+	resp, err := client.Do(req)
+	if err != nil {
+		log.Printf("[handler] forward voice to platform failed: %v", err)
+		return false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		log.Printf("[handler] platform rejected voice: HTTP %d", resp.StatusCode)
+		return false
+	}
+	log.Printf("[handler] forwarded voice from %s to platform (%d bytes, encode=%d, playtime=%dms)",
+		msg.FromUserID, len(data), v.EncodeType, v.Playtime)
+	return true
+}
